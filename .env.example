# Required by the Discord adapter.
DISCORD_TOKEN=replace-with-discord-bot-token
NEUROVI_REPO_ROOT=/repository
NEUROVI_TOOLS_ROOT=/opt/neurovi

# Optional: comma-separated guild IDs for immediate command synchronization.
NEUROVI_DISCORD_GUILD_IDS=

# Read command responses are private by default.
NEUROVI_DISCORD_EPHEMERAL=true
NEUROVI_COMMAND_TIMEOUT_SECONDS=120

# In server channels, users must mention the bot. The bot creates a dedicated
# help-session thread; follow-up messages in that bot-owned thread need no tag.
# Direct messages are always treated as help and do not create a thread.
NEUROVI_DISCORD_TEXT_HELP_ENABLED=true

# Reconciliation stays disabled when these role lists are empty.
NEUROVI_DISCORD_RECONCILE_ROLE_IDS=
NEUROVI_DISCORD_APPROVER_ROLE_IDS=

# Internal Discord-to-agent connection. Generate the shared token with:
# openssl rand -hex 32
NEUROVI_AGENT_GATEWAY_URL=http://reconciliation-agent:8080/invoke
NEUROVI_AGENT_GATEWAY_TOKEN=replace-with-random-internal-bearer-token
NEUROVI_AGENT_GATEWAY_TIMEOUT_SECONDS=180

# The agent writes to the document checkout using this host UID/GID.
NEUROVI_AGENT_UID=1000
NEUROVI_AGENT_GID=1000

# Consumed directly by the reconciliation agent runtime inside its container.
# Do not expose the API key to Discord messages, gateway payloads, or logs.
NEUROVI_LLM_PROVIDER=9router
NEUROVI_LLM_BASE_URL=
NEUROVI_LLM_API_KEY=
NEUROVI_LLM_MODEL=
NEUROVI_LLM_REASONING_EFFORT=high
NEUROVI_LLM_TIMEOUT_SECONDS=180
