NEUROVI_PRD_MCP_ENV_FILE=./prd-mcp.env.example
NEUROVI_PRD_MCP_REPOSITORY_ROOT=./neurovi-prd
NEUROVI_PRD_MCP_REPOSITORY=/repository
NEUROVI_PRD_MCP_BIND_HOST=192.168.1.20
NEUROVI_PRD_MCP_PORT=8767
NEUROVI_PRD_MCP_PUBLIC_URL=http://192.168.1.20:8767/mcp
NEUROVI_PRD_MCP_TOKEN=replace-with-at-least-32-random-characters
NEUROVI_PRD_MCP_MAX_RESPONSE_CHARS=128000

# Optional controlled reconciliation updates. Leave all values empty to expose
# only the six read tools. The gateway URL must use a private IPv4/loopback and
# the role IDs must also be allowed by the reconciliation-agent.
NEUROVI_PRD_MCP_AGENT_GATEWAY_URL=
NEUROVI_PRD_MCP_AGENT_GATEWAY_TOKEN=
NEUROVI_PRD_MCP_AGENT_GATEWAY_TIMEOUT_SECONDS=180
NEUROVI_PRD_MCP_ACTOR_ID=
NEUROVI_PRD_MCP_ACTOR_NAME=Neurovi PRD MCP
NEUROVI_PRD_MCP_ACTOR_ROLE_IDS=
